on fs
    # Recovery has its own init.rc (this file) separate from the one normal
    # boot uses (init.samsungexynos8890.rc, which only loads from /vendor
    # after switch_root). The sys.usb.configfs=0 fix added there for the
    # legacy android_usb gadget never reached recovery because of this split
    # - set it here too so our own recovery's USB actually comes up.
    setprop sys.usb.configfs 0
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.adb.nonblocking_ffs 0
    setprop ro.adb.nonblocking_ffs 0

    wait /dev/block/platform/155a0000.ufs
    symlink /dev/block/platform/155a0000.ufs /dev/block/bootdevice

